{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "/etc/fastfetch/careos.txt",
    "color": {
      "1": "38;2;85;154;255",
      "2": "38;2;46;204;142"
    },
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;85;154;255",
      "title": "38;2;234;240;255"
    }
  },
  "modules": [
    { "type": "title", "format": "CareOS {os-version}" },
    { "type": "custom", "key": "Base    ", "format": "Arch Linux rolling core" },
    "separator",
    { "type": "os", "key": "OS      " },
    { "type": "kernel", "key": "Kernel  " },
    { "type": "packages", "key": "Packages" },
    { "type": "shell", "key": "Shell   " },
    "separator",
    { "type": "de", "key": "Desktop " },
    { "type": "wm", "key": "WM      " },
    { "type": "theme", "key": "Theme   " },
    { "type": "font", "key": "Font    " },
    "separator",
    { "type": "cpu", "key": "CPU     " },
    { "type": "gpu", "key": "GPU     " },
    { "type": "memory", "key": "Memory  " },
    "separator",
    "colors"
  ]
}
